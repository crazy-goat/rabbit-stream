<?xml version="1.0"?>
<ruleset name="RabbitStream">
    <description>PSR-12 check. php-cs-fixer (.php-cs-fixer.dist.php) formats the code.</description>

    <!--
        PHP-CS-Fixer formats the code. PHP_CodeSniffer keeps the full PSR-12 check,
        because php-cs-fixer does not check every PSR-12 rule (for example the spacing
        of casts, control structures and method declarations).
        The Slevomat rules are removed: php-cs-fixer covers them.
    -->

    <!-- Scan src, tests, examples, and bin directories -->
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>bin</file>

    <!-- Exclude vendor and cache -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>*.cache</exclude-pattern>

    <!-- Full PSR-12 standard. It must be the first rule: a single-sniff rule ref
         that comes before it limits the sniff to one message code. -->
    <rule ref="PSR12"/>

    <!-- Example scripts mirror the docs snippets: they define helper classes and run logic in one file -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>

    <!--
        Example scripts mirror the docs snippets: they define helper classes and run logic in one file.
        kb-lint and the API signature check are CLI entrypoints that intentionally define helpers and execute main.
    -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>bin/kb-lint.php</exclude-pattern>
        <exclude-pattern>bin/check-api-signature.php</exclude-pattern>
    </rule>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Show sniff codes in report -->
    <arg value="s"/>

    <!-- Use colors in output -->
    <arg name="colors"/>
</ruleset>
