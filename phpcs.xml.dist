<?xml version="1.0"?>
<ruleset name="RabbitStream">
    <description>Checks that php-cs-fixer (.php-cs-fixer.dist.php) does not cover</description>

    <!--
        This ruleset is the slim remainder of the PHP_CodeSniffer standard.
        php-cs-fixer checks the formatting: indentation, spacing, braces, imports,
        strict_types, trailing commas and the other fixers in .php-cs-fixer.dist.php.
        The sniffs below check naming, line length, namespaces and side effects,
        which php-cs-fixer does not check. Verified with scratch files (#578).
        This is the only reason squizlabs/php_codesniffer stays in require-dev.
    -->

    <!-- Scan src, tests, examples, and bin directories -->
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>bin</file>

    <!-- Exclude vendor and cache -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>*.cache</exclude-pattern>

    <!-- Line length (warning) as in PSR-12 -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- Naming: camelCase methods, UPPER_CASE class constants, PascalCase class and interface names -->
    <rule ref="PSR1.Methods.CamelCapsMethodName"/>
    <rule ref="Generic.NamingConventions.UpperCaseConstantName"/>
    <rule ref="Squiz.Classes.ValidClassName"/>
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore"/>

    <!-- Example scripts mirror the docs snippets: they define helper classes and run logic in one file -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>

    <!-- Declare-statement placement and the blank lines of the file header -->
    <rule ref="PSR12.Files.FileHeader"/>

    <!-- Anonymous class spacing, and no blank line before the closing brace of a class -->
    <rule ref="PSR12.Classes.AnonClassDeclaration"/>
    <rule ref="PSR2.Classes.ClassDeclaration.CloseBraceAfterBody"/>

    <!--
        Example scripts mirror the docs snippets: they define helper classes and run logic in one file.
        kb-lint and the API signature check are CLI entrypoints that intentionally define helpers and execute main.
    -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>bin/kb-lint.php</exclude-pattern>
        <exclude-pattern>bin/check-api-signature.php</exclude-pattern>
    </rule>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Show sniff codes in report -->
    <arg value="s"/>

    <!-- Use colors in output -->
    <arg name="colors"/>
</ruleset>
