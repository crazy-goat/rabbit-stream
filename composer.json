{
    "name": "crazy-goat/rabbit-stream",
    "description": "A PHP client for the RabbitMQ Streams protocol.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "CrazyGoat\\RabbitStream\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Hałas Piotr",
            "email": "halaspiotr@gmail.com"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "CrazyGoat\\RabbitStream\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-zlib": "Needed to read gzip-compressed sub-batches (codec 1) in Osiris chunks"
    },
    "require-dev": {
        "ext-sockets": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "2.3.1",
        "phpunit/phpunit": "~10.5.0",
        "rector/rector": "2.7.0",
        "squizlabs/php_codesniffer": "^3.9 || ^4.0"
    },
    "scripts": {
        "lint": "bin/lint.sh",
        "lint:fix": "bin/lint.sh --fix",
        "kb-lint": "php bin/kb-lint.php",
        "kb-lint:fix": "php bin/kb-lint.php --fix",
        "phpstan": "phpstan analyse",
        "cs": [
            "php-cs-fixer fix --dry-run --diff",
            "phpcs --standard=phpcs.xml.dist"
        ],
        "cs-fix": [
            "php-cs-fixer fix",
            "phpcbf --standard=phpcs.xml.dist || true"
        ],
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:e2e": "phpunit --testsuite e2e",
        "test:suite-coverage": "php bin/check-test-suites.php",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    }
}
