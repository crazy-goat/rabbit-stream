{
    "name": "crazy-goat/rabbit-stream",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "CrazyGoat\\RabbitStream\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Hałas Piotr",
            "email": "halaspiotr@gmail.com"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "CrazyGoat\\RabbitStream\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~10.5.0",
        "squizlabs/php_codesniffer": "^3.9",
        "slevomat/coding-standard": "^8.15",
        "rector/rector": "~2.4.0",
        "phpstan/phpstan": "~2.1.0"
    },
    "scripts": {
        "lint": ["phpcs --standard=phpcs.xml.dist", "@rector", "@phpstan", "php bin/kb-lint.php", "php bin/check-docs-links.php"],
        "lint:fix": ["@rector:fix", "phpcbf --standard=phpcs.xml.dist", "php bin/kb-lint.php --fix"],
        "kb-lint": "php bin/kb-lint.php",
        "kb-lint:fix": "php bin/kb-lint.php --fix",
        "phpstan": "phpstan analyse",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs-fix": "phpcbf --standard=phpcs.xml.dist",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:e2e": "phpunit --testsuite e2e",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
